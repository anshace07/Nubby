{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nubby",
  "version": "0.1.2",
  "identifier": "com.ayushmishra.nubby",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nubby",
        "width": 1280,
        "height": 780,
        "minWidth": 1000,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Ayush Mishra",
    "copyright": "© 2026 Ayush Mishra. MIT licensed.",
    "category": "Productivity",
    "shortDescription": "A paper notebook for typed notes",
    "longDescription": "Nubby is a free, local, offline notebook for typed notes that feels like paper: handwriting fonts, ink colours, sticky notes and pictures you can place anywhere.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
